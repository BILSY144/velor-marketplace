generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  DELISTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum ShipmentStatus {
  PENDING
  LABEL_PURCHASED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

enum SellerTier {
  STARTER
  PRO
  ENTERPRISE // retired 2026-07-15 — kept only so legacy rows never break; treated as PRO in code
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String    @default("user")
  accounts          Account[]
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
  reviews           Review[]
  sessions          Session[]
  seller            Seller?
  wishlistItems     WishlistItem[]
  follows           Follow[]
  collections       Collection[]
  blocksMade        UserBlock[] @relation("BlocksMade")
  blocksReceived    UserBlock[] @relation("BlocksReceived")
  productQuestions  ProductQuestion[]
  reviewVotes       ReviewVote[]
  notifications     Notification[]
  setupToken            String?   @unique
  setupTokenExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Velor Social foundations (2026-07-29, LAW #4 build order stage 3).
// DORMANT AT LAUNCH: the /api/social/* routes 403 unless the
// VELOR_SOCIAL_ENABLED env var is exactly 'true', which William only sets
// after the OSA pack (docs/osa/) is signed. Additive-only schema.
// Privacy posture per docs/osa/dpia-velor-social.md: collections are
// PRIVATE BY DEFAULT; follows are not publicly listed at launch.
// ---------------------------------------------------------------------------

model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, sellerId])
  @@index([sellerId])
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isPublic  Boolean          @default(false)
  items     CollectionItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, productId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Seller {
  id                            String    @id @default(cuid())
  userId                        String    @unique
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName                     String
  description                   String?   @db.Text
  // Legal trader-status disclosure (William, 2026-07-19 -- Velor is open to
  // anyone, not just registered businesses, but the Seller Rules page has
  // always promised buyers this is shown because it affects their statutory
  // rights: consumer law gives buyers different protections when they buy
  // from a business/trader vs. a private individual). Carried over from
  // SellerApplication.sellerType at approval time in lib/provisionSeller.ts.
  // "individual" | "business". Nullable to tolerate sellers approved before
  // this field existed.
  sellerType                    String?
  country                       String?
  currency                      String    @default("GBP")
  stripeAccountId               String?   @unique
  stripeOnboarded               Boolean   @default(false)
  approved                      Boolean   @default(false)
  // Added 2026-07-23 -- fixes a real bug: `approved` was the ONLY status
  // field on this model, so "reject" and "never reviewed" were both just
  // approved:false and completely indistinguishable. Denying a bare/orphaned
  // seller (one with no SellerApplication -- see /api/auth/register) from
  // either the desktop admin console or Pulse silently did nothing visible:
  // the row just came right back as PENDING. rejectedAt/rejectionReason and
  // suspendedAt let both admin surfaces show a real REJECTED/SUSPENDED state
  // distinct from PENDING. `approved` remains the single field every other
  // code path gates on (product listing, dashboard access, etc.) -- these
  // are additive status labels only, set/cleared together with `approved`
  // by the approve/reject/suspend actions in app/api/admin/sellers/route.ts
  // and app/api/admin/pulse-sellers/route.ts.
  rejectedAt                    DateTime?
  rejectionReason               String?   @db.Text
  suspendedAt                   DateTime?
  tier                          SellerTier @default(STARTER)
  stripeCustomerId              String?   @unique
  stripeSubscriptionId          String?   @unique
  subscriptionStatus            String?
  subscriptionCurrentPeriodEnd  DateTime?
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  featuredSlotsUsed             Int       @default(0)
  featuredSlotsResetAt          DateTime?
  products                      Product[]
  orders                        Order[]
  shipments                     Shipment[]
  followers                     Follow[]
  journalPosts                  JournalPost[]
  collections                   SellerCollection[]
  likes                         SellerLike[]
  questions                     SellerQuestion[]
  shippingProfile               SellerShippingProfile?
  discountCodes                 DiscountCode[]
  payouts                       Payout[]
  supportTickets                SupportTicket[]
  apiKeys                       ApiKey[]
  liveStreams                   LiveStream[]
  countryFounded                 CountryFounder?
  sellerScore                   Float     @default(0)
  sellerBadge                   String?
  sellerScoreUpdatedAt          DateTime?
  scoreBreakdown                Json?
  rankingScore                   Float     @default(0)
  // Recomputed daily with the ranking: true when the seller is visibly
  // active in the social layer (journal posts / drop participation).
  activeMaker                    Boolean   @default(false)
  storeTheme                    String    @default("classic")
  storefrontUnlocked            Boolean   @default(false)
  storeLogo                     String?
  payoutRail                    String    @default("STRIPE")
  payoneerPayeeId               String?   @unique
  // dotsUserId/dotsOnboarded fields REMOVED from this model (William,
  // 2026-07-25). Dots.dev (added 2026-07-23 morning) turned out to be a
  // hard dead end the same evening -- US-businesses-only lock, Velor is
  // UK-registered and could never create an account -- and no real Dots
  // account was ever created (isDotsConfigured() always returned false),
  // so both columns were empty/false for every seller with zero data to
  // lose. Unlike the Trolley columns below, safe to let the next
  // `prisma db push` drop these along with the rest of the Dots removal.
  // Trolley payout rail fields REMOVED from the app (William, 2026-07-24 --
  // see lib/payoutRail.ts's header for why Trolley was tried 2026-07-23
  // evening then removed the next day). The trolleyRecipientId/
  // trolleyOnboarded COLUMNS still physically exist in the database (3 real
  // recipients were created against the live Trolley account before it was
  // cancelled) -- dropping them needs an actual migration against the live
  // DB, deliberately left for a separate, careful step rather than done
  // blind here. No application code references these fields anymore.
  identityVerified               Boolean   @default(false)
    // DEPRECATED (2026-07-18): foundingEligible/foundingPerksGrantedAt/
  // foundingBadge below were driven by SellerApplication.country, which
  // conflated the seller's registered business country with the culture
  // they sell -- see CountryFounder at the end of this file, which is the
  // live mechanism now. These fields are kept only so already-approved
  // rows don't break; nothing grants perks off them anymore.
// Founding-seller programme. foundingEligible is decided once, at approval
  // (lib/provisionSeller.ts): true only for the first approved seller from
  // a given country. It does NOT grant the perks by itself -- perks
  // (Pro tier at no charge, the founding badge) activate only once the
  // seller lists their first product; see lib/founding.ts. foundingBadge is
  // a separate flag from sellerBadge on purpose: sellerBadge is the
  // buyer-facing merit badge recalculated by the scoring cron and would
  // overwrite a value stored there.
  foundingEligible               Boolean   @default(false)
  foundingPerksGrantedAt         DateTime?
  foundingBadge                  Boolean   @default(false)
  // "Never lose money" fee-recovery ledger (William, 2026-07-31 -- see
  // docs/PAYOUTS.md's AMENDMENT for the full design). Stripe never returns
  // its original processing fee on a refund, and never returns its dispute
  // fee at all (win or lose). Both must still come from somewhere other
  // than the buyer (who is legally owed a full refund) or Velor's own
  // margin -- this is a running "owed to the platform" balance, incremented
  // when a return/lost-dispute causes an unrecoverable cost on that
  // seller's order, and decremented by lib/feeRecovery.ts's
  // deductOwedBalance() out of that seller's FUTURE payouts in
  // app/api/cron/release-payouts. Can go uncollected if the seller never
  // sells again -- same unavoidable exposure every marketplace carries.
  platformFeeOwedGBP             Float     @default(0)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
}

model SellerShippingProfile {
  id        String   @id @default(cuid())
  sellerId  String   @unique
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  street1   String
  street2   String?
  city      String
  state     String?
  zip       String
  country   String
  phone     String?
  // Optional flat buffer (GBP) the seller adds on top of every live carrier
  // quote -- covers packaging materials and rate drift between quote time and
  // label purchase. Added server-side in app/api/shipping/rates; capped at 25.
  handlingFeeGBP Float @default(0)
  // Seller-set flat international shipping price (GBP), added 2026-07-27 so
  // Velor can operate for sellers dispatching from ANY of the ~190 origin
  // countries, not just the handful with a live Shippo carrier account
  // (US/UK/DE/FR/ES/CA/AU today). When app/api/shipping/rates can't get a
  // real quote from Shippo for this seller's route, it uses this instead of
  // the old $0.00 "Custom Quote" placeholder -- so buyers always see a real,
  // honest price and sellers always get reimbursed for shipping. Null means
  // "not set yet"; distinct from 0, which is a deliberate free-shipping
  // choice. Re-read fresh from the DB at payment-intent time -- never
  // trusted from the client, same pattern as every other shipping amount.
  internationalFlatRateGBP Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String?       @db.Text
  price         Float
  compareAt     Float?
  images        String[]
  category      String
  tags          String[]
  stock         Int           @default(0)
  status        ProductStatus @default(PENDING_REVIEW)
  featured      Boolean       @default(false)
  featuredAt    DateTime?
  weightGrams   Float?
  lengthCm      Float?
  widthCm       Float?
  heightCm      Float?
  hsCode        String?
  originCountry String?
  // Closed vocabulary terms (max 2) from lib/specialities.ts - the origin x
  // speciality lattice. Validated server-side via validateSpecialitySelection.
  specialities  String[]      @default([])
  isHandmade    Boolean       @default(false)
  makerStory    String?       @db.Text
  materials     String?
  // 2026-07-28 listing-form overhaul (William-approved spec in CLAUDE.md):
  // videoUrl -- free video-by-link (YouTube/Vimeo) shown on the PDP; true
  // upload deferred until "established properly and making good profit"
  // (William). madeToOrder + leadTimeDays -- artisan made-when-ordered
  // listings; stock stays as the seller's capacity number so checkout logic
  // is untouched. sizeGuide -- seller's own measurements text for garments.
  videoUrl      String?
  madeToOrder   Boolean       @default(false)
  leadTimeDays  Int?
  sizeGuide     String?       @db.Text
  requiresCertificate Boolean @default(false)
  certificates  ProductCertificate[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  messages      Message[]
  reviews       Review[]
  collectionItems CollectionItem[]
  journalPosts  JournalPost[]
  dropItems     DropItem[]
  questions     ProductQuestion[]
  // Colour/size options for this listing (added 2026-07-27 so sellers no
  // longer have to create a separate listing per colour/size -- see
  // ProductVariant below). Empty for the vast majority of existing listings,
  // which is intentional: Product.price/Product.stock stay the source of
  // truth whenever a product has zero variant rows, so every listing that
  // predates this feature keeps working exactly as it did before, no
  // migration needed. A seller opts in per listing from the dashboard.
  variants      ProductVariant[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// A single colour/size combination of a Product, with its own stock and an
// optional price override. Deliberately lightweight (Shopify-style
// "options on one product" rather than Amazon-style separate child
// listings) -- origin, certificates, HS code, maker story etc. stay once on
// the parent Product since they don't vary by colour/size, only stock/price/
// images do. id is intentionally NOT referenced as a live foreign key from
// OrderItem.variantId (see below) -- a variant can be edited or removed by
// the seller after an order was placed without ever corrupting that order's
// history, since OrderItem stores its own snapshot (variantId + color +
// size) at the time of purchase, not a live relation.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // 2026-07-28: generic named option ("Dragon design", "Lavender", "Set of
  // 3") -- one listing, many versions with their own price/stock/photos,
  // for ALL product types (William), not just colour/size. A variant needs
  // label OR color OR size; colour+size clothing rows keep working as-is.
  label         String?
  color         String?
  size          String?
  sku           String?
  stock         Int      @default(0)
  priceOverride Float?
  images        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, color, size])
}

model Order {
  id                String          @id @default(cuid())
  sellerId          String
  seller            Seller          @relation(fields: [sellerId], references: [id])
  // A single Stripe payment can now produce MULTIPLE Orders -- one per
  // seller in the cart (see lib/orders.ts). stripePaymentId is therefore no
  // longer unique on its own; the compound unique below is what keeps order
  // creation idempotent -- at most one Order per (payment, seller) pair,
  // exactly matching one parcel/shipment per seller per checkout.
  stripePaymentId   String?
  status            OrderStatus     @default(PENDING)
  deliveredAt       DateTime?
  // When the seller first reported shipping (tracking added). Anchor for the
  // 30-day delivery auto-confirm backstop (William, 2026-07-21).
  shippedAt         DateTime?
  // How DELIVERED was confirmed: WEBHOOK (Shippo tracking), BUYER (confirm
  // button), AUTO (30-day backstop), ADMIN (manual override). Null on orders
  // delivered before this field existed.
  deliveryConfirmedBy String?
  subtotal          Float
  platformFee       Float           @default(0)
  sellerEarnings    Float           @default(0)
  // UK deemed-supplier VAT held by VELOR for remittance to HMRC (imports
  // <= GBP 135 sold to UK buyers via the marketplace). Never part of
  // sellerEarnings or platformFee -- a separate pot. GBP. Additive
  // 2026-07-29; see docs/VAT-OMP-POSITION.md.
  vatCollected      Float           @default(0)
  currency          String          @default("gbp")
  customerEmail     String
  customerName      String?
  shippingAddress   Json?
  items             OrderItem[]
  returnRequests    ReturnRequest[]
  shipment          Shipment?
  payout            Payout?
  dispute           Dispute?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([stripePaymentId, sellerId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  price      Float
  commission Float?
  // Snapshot of the variant purchased, resolved fresh from ProductVariant at
  // order-creation time (lib/orders.ts) -- NOT a live foreign key, so
  // editing/removing a variant later never corrupts past order history.
  // size added 2026-07-27 alongside color (was previously missing, even
  // though color already existed as scaffolding).
  variantId  String?
  color      String?
  size       String?
}


model Shipment {
  id                String          @id @default(cuid())
  sellerId          String
  seller            Seller          @relation(fields: [sellerId], references: [id])
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id])
  shippoShipmentId  String?
  shippoRateId      String?
  shippoLabelId     String?
  // Which provider bought this label: 'SHIPPO' | 'EASYSHIP' | null (Tier B
  // self-ship, no Velor-purchased label). Added 2026-07-28 with the
  // Easyship adapter (additive column, safe with db push).
  labelProvider     String?
  easyshipShipmentId String?
  trackingNumber    String?
  trackingUrl       String?
  carrier           String?
  status            ShipmentStatus  @default(PENDING)
  labelUrl          String?
  // True once the tracking number is successfully registered with Shippo's
  // /tracks endpoint (what makes the delivery webhook fire). False means
  // registration failed or never ran -- the confirm-deliveries cron retries
  // these so no order can silently never reach DELIVERED.
  // What Velor actually paid for the label (GBP). Used to deduct the cost
  // from the seller share when the buyer paid less shipping than the label
  // (e.g. seller-chosen FREE shipping on an auto-label lane, William
  // 2026-07-29: the seller bakes it into the price).
  labelCostGBP      Float?
  trackRegistered   Boolean         @default(false)
  events            ShipmentEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model DiscountCode {
  id          String    @id @default(cuid())
  sellerId    String
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code        String    @unique
  type        String    @default("PERCENTAGE")
  value       Float     @default(0)
  minOrder    Float?
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  // Empty array = applies to the seller's entire catalogue (store-wide).
  // Non-empty = restricted to only these product IDs.
  productIds  String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payout {
  id               String   @id @default(cuid())
  sellerId         String
  seller           Seller   @relation(fields: [sellerId], references: [id])
  orderId          String?  @unique
  order            Order?   @relation(fields: [orderId], references: [id])
  amount           Float
  currency         String   @default("gbp")
  stripeTransferId String?  @unique
  payoneerPayoutId String?  @unique
  // dotsPayoutId field removed from this model (William, 2026-07-25) -- see
  // the Seller model's dotsUserId/dotsOnboarded comment above for why.
  // trolleyPayoutId column removed from this model (William, 2026-07-24) --
  // Trolley was removed from the app the same day it was tested end-to-end;
  // see lib/payoutRail.ts's header. The column still physically exists in
  // the database; dropping it needs a separate migration, deliberately not
  // attempted here.
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AgentLog {
  id        String   @id @default(cuid())
  agentName String
  action    String
  details   Json?
  status    String   @default("success")
  createdAt DateTime @default(now())
}

model ReturnRequest {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerEmail String
  reason        String   @db.Text
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SellerApplication {
  id                String    @id @default(cuid())
  businessName      String
  contactEmail      String
  contactName       String
  storeDescription  String?   @db.Text
  website           String?
// Bcrypt hash of the password the applicant chose on the /apply form
// (2026-07-19, William: he had to reset his password after self-approving
// because the application never asked for one). Never store the plaintext
// password anywhere -- app/api/seller/apply/route.ts hashes it before this
// row is written. Nullable so applications submitted before this field
// existed still approve fine, just via the old one-time activation-link
// path in lib/provisionSeller.ts.
passwordHash      String?
  // Legal trader-status disclosure captured on the /apply form (William,
  // 2026-07-19). "individual" | "business" -- see the matching field on
  // Seller for why this exists. Nullable so applications submitted before
  // this field existed still approve fine (lib/provisionSeller.ts just
  // carries over whatever is here, including null/undefined).
  sellerType        String?
  productCategories String[]
  sampleImages      String[]
  country           String?
  prospectId        String?
  // Ship-from address, captured at application time so every approved
  // seller already has a SellerShippingProfile the moment they're
  // provisioned (see lib/provisionSeller.ts) -- no seller can reach
  // checkout for their first product without one, closing the gap that
  // caused shipping/rates to fall back to a placeholder quote for sellers
  // who never got around to filling in Settings -> Shipping. Optional at
  // the schema level only so existing PENDING applications submitted
  // before this field existed don't break; the /apply form and API route
  // both require these for every NEW submission.
  shippingName      String?
  shippingCompany   String?
  shippingStreet1   String?
  shippingStreet2   String?
  shippingCity      String?
  shippingState     String?
  shippingZip       String?
  shippingCountry   String?
  shippingPhone     String?
  // Identity verification. No seller is approved without a VERIFIED document
  // check. Velor never receives or stores the document itself -- Stripe hosts
  // the capture and returns only a verdict. RESTRICTED means Stripe Identity is
  // legally barred from verifying this jurisdiction (China, Russia, Cuba, Iran,
  // North Korea, Syria); those wait for the Payoneer KYC rail.
  // NOT_STARTED | PENDING | PROCESSING | VERIFIED | FAILED | CANCELED | RESTRICTED
  verificationStatus    String    @default("NOT_STARTED")
  verificationSessionId String?   @unique
  verifiedAt            DateTime?
  verificationNotes     String?   @db.Text
  verificationRemindersSent      Int       @default(0)
  verificationReminderLastSentAt DateTime?
  status            String    @default("PENDING")
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SellerProspect {
  id           String        @id @default(cuid())
  name         String
  platform     String
  storeUrl     String
  email        String?
  category     String
  score        Int           @default(50)
  country      String?
  sellerType   String
  notes        String?
  status       String        @default("prospected")
  // AI qualification gate (lib/prospectQualify.ts, app/api/cron/
  // qualify-prospects). null = not yet screened. Stage 1 of outreach-auto
  // will only send to qualified === true -- a scout hit is a search-engine
  // guess, not a verified match, and William's standing rule is that
  // factory/wholesale/service businesses must never receive outreach.
  qualified          Boolean?
  qualificationNotes String?   @db.Text
  qualifiedAt        DateTime?
  outreachLogs OutreachLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model OutreachLog {
  id         String         @id @default(cuid())
  prospectId String
  prospect   SellerProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  emailType  String
  subject    String
  sentAt     DateTime       @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  productId  String?
  content    String
  // Customisation-request / general chat photos (2026-08-01, William --
  // buyers had no way to send a seller a reference photo, e.g. for a
  // custom pet portrait). Stored in R2 like Review.images. Every upload is
  // OCR-scanned server-side and run through the same contact-info filter
  // as message text before it is ever saved -- see lib/imageContentScan.ts
  // and app/api/messages/route.ts. Capped at 4 per message.
  images     String[] @default([])
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Dispute {
  id         String   @id @default(cuid())
  orderId    String   @unique
  raisedBy   String
  reason     String
  evidence   String?
  status     String   @default("OPEN")
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String   @default("")
  // Review photos (2026-07-29, Amazon-comparison item): buyer-supplied,
  // stored in R2 like every other image (never base64 in Postgres).
  images    String[] @default([])
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     ReviewVote[]
}

// "Helpful" votes on reviews (2026-07-29): one per person per review, never
// on your own review. Most-helpful reviews list first on the PDP.
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String
  location    String?
  occurredAt  DateTime
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model FxRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  rate      Float
  fetchedAt DateTime @default(now())

  @@unique([base, quote])
}


enum SupportPriority {
  STANDARD
  PRIORITY
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

model SupportTicket {
  id        String               @id @default(cuid())
  sellerId  String?
  seller    Seller?              @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  name      String
  email     String
  subject   String
  message   String               @db.Text
  priority  SupportPriority      @default(STANDARD)
  status    SupportTicketStatus  @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ApiKey {
  id         String    @id @default(cuid())
  sellerId   String
  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveStream {
  id            String                     @id @default(cuid())
  sellerId      String
  seller        Seller                     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String?                    @db.Text
  roomName      String                     @unique
  status        LiveStreamStatus           @default(SCHEDULED)
  scheduledFor  DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  productIds    String[]
  peakViewers   Int                        @default(0)
  reportCount   Int                        @default(0)
  recordingUrl  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  viewerSessions LiveStreamViewerSession[]
  reports        LiveStreamReport[]

  @@index([sellerId])
  @@index([status])
}

model LiveStreamViewerSession {
  id         String     @id @default(cuid())
  streamId   String
  liveStream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  identity   String
  joinedAt   DateTime   @default(now())
  leftAt     DateTime?

  @@index([streamId])
  @@index([joinedAt])
}

// One row per (stream, reporter) so a single account can never report the
// same stream more than once -- app/api/live/[room]/report/route.ts used to
// take an unauthenticated POST and blindly increment LiveStream.reportCount,
// so anyone (no session required) could script 3 requests and force ANY
// seller's live stream to auto-end. The route now requires a signed-in
// session and creates a row here per genuinely distinct reporter; the
// @@unique makes a repeat report from the same account a no-op instead of
// counting again.
model LiveStreamReport {
  id            String     @id @default(cuid())
  streamId      String
  liveStream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  reporterEmail String
  // Report form (William, 2026-07-21): every report is filled in with a
  // reason; free-text details optional except for reason "other". Default
  // keeps rows created before the form valid.
  reason        String     @default("unspecified")
  details       String?    @db.Text
  createdAt     DateTime   @default(now())

  @@unique([streamId, reporterEmail])
  @@index([streamId])
}

// ---------------------------------------------------------------------------
// Online Safety tooling (2026-07-29, built per the SIGNED online safety
// policy's build list in docs/osa/online-safety-policy.md): a report route
// for EVERY kind of user-generated content (reviews, messages, listings,
// streams, sellers), open to signed-in users AND non-users alike, plus
// block/mute between members. Additive-only.
// ---------------------------------------------------------------------------

model ContentReport {
  id             String    @id @default(cuid())
  // REVIEW | MESSAGE | LISTING | STREAM | SELLER | OTHER
  contentType    String
  contentId      String?
  // Non-users reporting from /safety may only know the page address.
  contentUrl     String?
  reporterEmail  String
  reporterUserId String?
  reason         String
  details        String?   @db.Text
  // OPEN | RESOLVED | DISMISSED
  status         String    @default("OPEN")
  resolution     String?   @db.Text
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  // One report per person per piece of content (NULL contentId rows are
  // distinct under Postgres semantics, which is what we want for URL-only
  // reports from non-users).
  @@unique([contentType, contentId, reporterEmail])
  @@index([status, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---------------------------------------------------------------------------
// Public Q&A on listings (2026-07-29, from William's Amazon PDP comparison).
// Buyers ask on the listing; ONLY the listing's own seller answers; only
// answered questions are shown publicly (the asker also sees their own
// pending ones). UGC safety per the signed OSA pack: shared content filter
// on questions AND answers, report route (contentType QUESTION), caps.
// ---------------------------------------------------------------------------

model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, answeredAt])
}

// ---------------------------------------------------------------------------
// Maker Journal (Velor Social stage 4, 2026-07-29, plan section 3: "the
// studio journal that sells" -- sellers document their process; the future
// Workshop Feed is a VIEW over these journals, never a separate posting
// surface). UGC safety per the signed OSA pack: text through the shared
// content filter, images through R2, report route (contentType JOURNAL),
// posting caps. Gated by VELOR_SOCIAL_ENABLED like all /api/social routes.
// ---------------------------------------------------------------------------

model JournalPost {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title     String?
  body      String   @db.Text
  images    String[] @default([])
  videoUrl  String?
  // Optional link to one of the seller's own listings ("the journal that
  // sells" -- process post -> piece for sale).
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Journal-page build-out (William's Makers' Circle design, 2026-07-30):
  // optional story sections matching the public journal page's tabs, and
  // up to four shoppable listings per entry ("Shop products from this
  // journal"). All additive; productId above stays as the primary link.
  makingProcess String?  @db.Text
  notesTips     String?  @db.Text
  behindScenes  String?  @db.Text
  productIds    String[] @default([])
  // Creator Journals studio (William's dashboard design, 2026-07-30):
  // status grows DRAFT | SCHEDULED | ARCHIVED alongside PUBLISHED | HIDDEN;
  // scheduled entries go live at scheduledAt (read-time check in the
  // public queries). Counters are real from day one -- they start at zero
  // and fill as buyers interact. featured is admin/homepage curation.
  scheduledAt   DateTime?
  category      String?
  featured      Boolean  @default(false)
  viewCount     Int      @default(0)
  productClicks Int      @default(0)
  likes         JournalLike[]
  comments      JournalComment[]
  // PUBLISHED | HIDDEN (HIDDEN = taken down by moderation, kept for audit)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status, createdAt])
}

// One like per person per journal entry (Creator Journals counters).
model JournalLike {
  id        String      @id @default(cuid())
  postId    String
  post      JournalPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())

  @@unique([postId, userId])
}

// Buyer comments on a journal entry. Same UGC posture as reviews/messages:
// content-filtered at the API, PUBLISHED | HIDDEN for moderation.
//
// parentId (2026-08-01, William: "everythink can be shown on there journal
// pages like q&a thats real interaction ... that draws in new buyers") --
// a one-level reply so a comment thread can work as real per-entry Q&A: a
// buyer's top-level comment is the "question", replies from the seller OR
// other buyers are the "answers". isSeller is never stored -- it's computed
// at read time (authorId === the post's seller.userId) so it can never go
// stale if a store ever changes hands.
model JournalComment {
  id        String           @id @default(cuid())
  postId    String
  post      JournalPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  body      String           @db.Text
  status    String           @default("PUBLISHED")
  parentId  String?
  parent    JournalComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   JournalComment[] @relation("CommentReplies")
  createdAt DateTime         @default(now())

  @@index([postId])
  @@index([parentId])
}

// "Ask the Maker" -- a general public Q&A board on the seller's journal
// page, not tied to any single entry (William, 2026-08-01, same request as
// the JournalComment reply nesting above: real interaction that "draws in
// new buyers"). Any signed-in buyer can ask; the seller AND other buyers
// can answer, same open posture as journal comments. Auto-public the
// instant it's posted -- the seller can hide a bad question or answer
// afterwards (status flips to HIDDEN, never deleted, matching every other
// moderation flag in this schema).
model SellerQuestion {
  id        String         @id @default(cuid())
  sellerId  String
  seller    Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  askerId   String
  body      String         @db.Text
  status    String         @default("PUBLISHED")
  createdAt DateTime       @default(now())
  answers   SellerAnswer[]

  @@index([sellerId])
}

model SellerAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   SellerQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  body       String         @db.Text
  status     String         @default("PUBLISHED")
  createdAt  DateTime       @default(now())

  @@index([questionId])
}

// A seller's own public showcase grouping of their products (Maria's
// design's "Maria's Collections" sidebar card, 2026-07-30, William: "wired
// up exactly like Maria's page"). NOT the same thing as the Collection
// model above -- that one is a buyer's private saved-items folder
// (optionally made public), scoped under a DPIA for buyer data. This one
// is pure seller merchandising: no personal data at all, just the
// seller's own product IDs grouped under a name they choose, managed from
// the Creator Journals dashboard's "Manage Collections" panel and shown
// on their journal/storefront page. productIds follows the same simple
// String[] pattern already used on JournalPost rather than a join table,
// for consistency with the rest of this schema.
model SellerCollection {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name       String
  productIds String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sellerId])
}

// A buyer liking a seller (the journal page's "Never Miss A Story" heart
// icon, William 2026-08-01: distinct from Follow -- a lightweight signal
// separate from actually following for updates). One like per person per
// seller, same shape as JournalLike.
model SellerLike {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([sellerId, userId])
}

enum CertificateType {
  EXPORT_PERMIT
  IMPORT_PERMIT
  PHYTOSANITARY
  OTHER
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Certificate documents for regulated-material listings (CITES export/import
// permits, phytosanitary certificates, etc). A product with
// requiresCertificate set must have at least one VERIFIED certificate before
// it can be APPROVED. Documents are stored as compressed data URLs in
// Postgres (same zero-new-infrastructure pattern as Seller.storeLogo).
// Retained indefinitely as the audit trail regulators could request.
model ProductCertificate {
  id                 String            @id @default(cuid())
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type               CertificateType   @default(EXPORT_PERMIT)
  documentData       String            @db.Text
  fileName           String?
  destinationCountry String?
  issuedBy           String?
  expiresAt          DateTime?
  status             CertificateStatus @default(PENDING)
  reviewNotes        String?           @db.Text
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([productId])
  @@index([status])
}

// Password reset — email-verified, one-hour tokens (William's standing
// requirement, 2026-07-15). Token stored as a SHA-256 hash; the raw value
// only ever exists inside the emailed link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// "Notify me" for scheduled live streams (2026-07-20). A row means one
// person asked to be told when this stream goes live. Signed-in users are
// stored by userId (their registered PushTokens are looked up at send
// time); app users who are not signed in are stored by their Expo push
// token directly. No relations declared so LiveStream stays untouched.
model LiveStreamInterest {
  id        String   @id @default(cuid())
  streamId  String
  userId    String?
  pushToken String?
  createdAt DateTime @default(now())

  @@unique([streamId, userId])
  @@unique([streamId, pushToken])
  @@index([streamId])
}

// Expo push tokens — one row per device, so launch events (opening bells,
// order updates) can notify the Velor app with the bell chime.
model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String
  userId     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// On-demand page-translation cache -- one row per (source string, language).
// Written by app/api/translate; each unique string is translated by the
// Anthropic API exactly once per language, then served from here forever.
model TranslationCache {
  id         String   @id @default(cuid())
  hash       String
  lang       String
  source     String
  translated String
  createdAt  DateTime @default(now())

  @@unique([hash, lang])
}

// Per-IP daily counter of NEW (cache-miss, model-translated) strings --
// the anti-abuse budget on /api/translate (2026-07-17, William: protect
// translation spend). Cached strings are served freely and never counted.
model TranslationIpDaily {
  id    String @id @default(cuid())
  ip    String
  day   String // YYYY-MM-DD (UTC)
  count Int    @default(0)

  @@unique([ip, day])
}


// Founding credit is tied to the ORIGIN of the product a seller lists, not
// to where the seller's business is registered (Seller.country) -- a
// single seller may sell goods from several cultures, so credit is earned
// per listing's actual origin, not claimed at application time. Both
// countryCode and sellerId are unique: one founder per country, and each
// seller may found at most one country page (William, 2026-07-18). First
// APPROVED product from that origin wins the row; the unique constraints
// make a race between two sellers resolve safely with no extra locking.
// Written by lib/founding.ts's grantCountryFounderIfFirst(), called from
// the auto-moderate cron and the manual admin approval route -- the only
// two places a product actually transitions into APPROVED status.
model CountryFounder {
  id          String   @id @default(cuid())
  countryCode String   @unique
  countryName String
  sellerId    String   @unique
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId   String
  grantedAt   DateTime @default(now())
}

// Mobile app install & usage telemetry (2026-07-19). One row per install --
// the app generates an anonymous random installId on first launch and pings
// /api/app/install on every cold start (creates the row once, then bumps
// lastSeenAt). Country is derived server-side from Vercel's request geo
// header, same as PageView -- nothing extra is read from the device. Covered
// by the Play Data safety declaration ("Device or other IDs", app
// functionality + fraud prevention). No age or personal data is collected.
model AppInstall {
  id         String   @id @default(cuid())
  installId  String   @unique
  platform   String
  osVersion  String?
  appVersion String?
  country    String?
  language   String?
  currency   String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// --- Platform-default international shipping estimate (2026-07-27) ---
// Added so checkout NEVER depends on an individual seller having configured
// shipping. Every seller has always had the option to set their own flat
// rate (SellerShippingProfile.internationalFlatRateGBP), but requiring that
// before checkout works put a platform-wide problem in each seller's hands.
// This is the platform-wide safety net underneath it: a zone x weight-band
// GBP estimate, calibrated from real live Shippo quotes gathered by a one-off
// admin survey (see app/api/admin/shipping-rate-survey), used automatically
// whenever neither a live Shippo quote NOR a seller flat rate is available.
// Priority order lives in app/api/shipping/rates/route.ts's
// flatRateOrFallback(): live Shippo quote > seller flat rate > this platform
// default > (only if even this has no data) the old quote-required block.

// Raw live-quote data points collected by the one-off shipping-rate-survey
// admin endpoint. Kept for audit / future recalibration -- NOT read directly
// at checkout time (PlatformShippingRate below is the aggregated table
// checkout actually uses).
model ShippingRateBenchmark {
  id                String   @id @default(cuid())
  originCountry     String
  destinationCountry String
  zone              String
  weightGrams       Int
  carrier           String
  service           String
  amountGBP         Float
  estimatedDays     Int?
  surveyedAt        DateTime @default(now())

  @@index([zone, weightGrams])
  @@index([destinationCountry])
}

// The operative platform-default rate table checkout actually reads.
// baseAmountGBP is the calibrated estimate BEFORE the levy (see
// PlatformShippingConfig.levyPercent below) -- the levy is applied at read
// time, not baked in, so changing the levy % instantly re-prices every
// zone/weight combination without re-running the survey.
model PlatformShippingRate {
  id                 String   @id @default(cuid())
  zone               String
  weightBandMinGrams Int
  weightBandMaxGrams Int
  baseAmountGBP      Float
  sampleSize         Int      @default(0)
  lastSurveyedAt     DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([zone, weightBandMinGrams])
}

// PDP delivery-estimate cache (2026-07-29, from William's Amazon-comparison
// direction: live shipping cost + arrival estimate on the product page).
// One row per seller x destination country x weight band, filled by
// /api/shipping/estimate calling the SAME /api/shipping/rates engine
// checkout uses (so PDP numbers can never drift from checkout numbers),
// then reused for 24h so product pages never hammer Shippo/Easyship.
model ShippingEstimate {
  id                 String   @id @default(cuid())
  sellerId           String
  destCountry        String
  weightBandMinGrams Int
  amountGBP          Float
  carrier            String
  service            String
  estimatedDays      Int?
  // true when the number came from the seller-flat-rate / platform-default
  // tier rather than a live carrier quote -- the UI words it as "estimated".
  isEstimate         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sellerId, destCountry, weightBandMinGrams])
}

// Singleton config row (id is always "singleton"). levyPercent is the
// admin-configurable buffer added on top of PlatformShippingRate estimates
// only -- never on top of a live Shippo quote or a seller's own flat rate,
// since those already carry real accuracy/ownership and don't need a
// platform estimation-risk buffer. Default 8%, William's call 2026-07-27.
model PlatformShippingConfig {
  id          String   @id @default("singleton")
  levyPercent Float    @default(8)
  updatedAt   DateTime @updatedAt
}

// Weekly Drop -- "Fresh from the Workshop" (Velor Social stage 6, plan
// docs/velor-social-5-year-plan.md section 12 item 5, built 2026-07-29).
// The appointment mechanic: one moment a week when new pieces go live
// together. All models additive; applied by the deploy db push.
model Drop {
  id           String     @id @default(cuid())
  title        String     @default("Fresh from the Workshop")
  scheduledAt  DateTime
  // Set when the pre-drop digest email has gone out for this drop.
  digestSentAt DateTime?
  // Set when the drop-open bell notifications have gone out for this drop.
  bellNotifiedAt DateTime?
  items        DropItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([scheduledAt])
}

model DropItem {
  id        String   @id @default(cuid())
  dropId    String
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String
  createdAt DateTime @default(now())

  @@unique([dropId, productId])
  @@index([dropId])
  @@index([sellerId])
}

// Opt-in list for the weekly drop digest email. Deliberately its own
// table (not a User flag): guests can subscribe, consent is explicit
// (PECR-friendly), and unsubscribe is a one-click delete.
model DropDigestSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// In-app notification bell (Velor Social plan section 7: "a table + a
// badge"). Fan-out happens at write time (e.g. journal post -> followers).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NEW_JOURNAL_POST | NEW_FOLLOWER | DROP_OPEN | ... (extensible)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Velor Roots Foundation checkout micro-donation ledger (William, 2026-07-31).
// One row per PAID PaymentIntent that included a donation -- NOT per seller
// order, since a buyer's optional 20p/50p/£1 add-on is a single amount for
// the whole cart, independent of how many sellers/Orders that payment spawns
// (see lib/orders.ts createOrderFromPaymentIntent, which creates one Order
// per seller but should only ever create ONE CharityDonation per payment).
// stripePaymentId is unique for exactly that reason: idempotent no matter how
// many times the webhook or the checkout-confirmation accelerator calls
// createOrderFromPaymentIntent for the same PaymentIntent.
//
// IMPORTANT: this table can accumulate rows the moment
// CHARITY_DONATIONS_ENABLED is flipped on server-side, but Velor Roots
// Foundation is NOT YET a registered UK charity as of 2026-07-31 -- both
// CHARITY_DONATIONS_ENABLED (server) and NEXT_PUBLIC_CHARITY_DONATIONS_ENABLED
// (client) must stay unset/false until the charity is legally registered
// with the Charity Commission. Do not remove this comment when flipping the
// flags -- update it to record the registration date instead.
model CharityDonation {
  id              String   @id @default(cuid())
  stripePaymentId String   @unique
  amountGBP       Float
  customerEmail   String?
  // Snapshot status of the recipient charity at the time this donation was
  // collected -- always "VELOR_ROOTS_FOUNDATION_PENDING_REGISTRATION" until
  // the charity's registered number is recorded here after registration.
  charityStatus   String   @default("VELOR_ROOTS_FOUNDATION_PENDING_REGISTRATION")
  // Set once Velor Roots Foundation is registered and the collection
  // agreement is signed -- null until then. Remittance is a manual,
  // trustee-overseen process while the charity is young, not automated here.
  remittedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}
